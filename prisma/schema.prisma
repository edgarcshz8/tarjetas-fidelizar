generator client {
  provider = "prisma-client-js"
}

// DESARROLLO LOCAL: provider = "sqlite"
// PRODUCCIÓN (Dokploy): cambiar a provider = "postgresql"
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  logoUrl        String?
  primaryColor   String   @default("#1a1a2e")
  secondaryColor String   @default("#ffffff")
  accentColor    String   @default("#e94560")
  latitude       Float?
  longitude      Float?
  locationName   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  programs      LoyaltyProgram[]
  users         User[]
  subscriptions Subscription[]

  @@map("businesses")
}

model LoyaltyProgram {
  id                String   @id @default(cuid())
  businessId        String
  name              String
  description       String?
  stampsRequired    Int      @default(10)
  rewardDescription String
  stampIconUrl      String?
  rewardIconUrl     String?
  logoUrl           String?
  backgroundColor   String   @default("#1a1a2e")
  foregroundColor   String   @default("#ffffff")
  labelColor        String   @default("#cccccc")
  stampEmoji        String?  @default("⭐")
  isActive          Boolean  @default(true)
  // Google Wallet: ID de la clase (loyaltyClass) creada en Google
  googleClassId     String?
  // Mensaje personalizado de cumpleaños (soporta {nombre}, {negocio}, {premio})
  birthdayTitle     String?
  birthdayMessage   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  passes   CustomerPass[]

  @@map("loyalty_programs")
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  birthDate DateTime?
  createdAt DateTime  @default(now())

  passes CustomerPass[]

  @@unique([email])
  @@map("customers")
}

model CustomerPass {
  id                 String   @id @default(cuid())
  serialNumber       String   @unique @default(cuid())
  authToken          String   @default(cuid())
  customerId         String
  programId          String
  currentStamps      Int      @default(0)
  totalRewardsEarned Int      @default(0)
  rewardReady        Boolean  @default(false)
  // Apple Wallet: token del pase para APNS
  applePassUpdatedAt DateTime @default(now())
  // Último día (YYYY-MM-DD, hora Chile) en que se envió el aviso de cumpleaños.
  // Evita re-marcar el pase y re-enviar push si el cron corre varias veces el mismo día.
  birthdayNotifiedOn String?
  // Google Wallet: ID del objeto loyaltyObject
  googleObjectId     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  program  LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  stamps   Stamp[]
  devices  AppleDevice[]

  @@map("customer_passes")
}

// Registro de dispositivos Apple para push updates
model AppleDevice {
  id                     String   @id @default(cuid())
  deviceLibraryIdentifier String
  passSerialNumber       String
  pushToken              String
  createdAt              DateTime @default(now())

  pass CustomerPass @relation(fields: [passSerialNumber], references: [serialNumber], onDelete: Cascade)

  @@unique([deviceLibraryIdentifier, passSerialNumber])
  @@map("apple_devices")
}

model Stamp {
  id         String   @id @default(cuid())
  passId     String
  addedById  String
  note       String?
  createdAt  DateTime @default(now())

  pass    CustomerPass @relation(fields: [passId], references: [id], onDelete: Cascade)
  addedBy User         @relation(fields: [addedById], references: [id], onDelete: NoAction)

  @@map("stamps")
}

model User {
  id         String   @id @default(cuid())
  businessId String
  email      String   @unique
  password   String
  name       String
  role       String   @default("STAFF") // "OWNER" | "ADMIN" | "STAFF"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stamps   Stamp[]

  @@map("users")
}

// ─── Pagos / Suscripciones ────────────────────────────────────────────────────

// Planes de suscripción disponibles en la plataforma
model Plan {
  id            String         @id @default(cuid())
  name          String         // ej: "Básico", "Pro"
  priceClp      Int            // Precio en CLP (moneda de cero decimales)
  intervalDays  Int            @default(30)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

// Suscripción activa de cada Business al servicio SaaS
model Subscription {
  id                 String             @id @default(cuid())
  businessId         String
  planId             String
  status             SubscriptionStatus @default(PENDING)
  // Identificadores de Mercado Pago
  mpSubscriptionId   String?            // ID interno MP (preapproval / payment_id)
  mpPreapprovalId    String?            // ID del preapproval plan en MP
  mpPayerId          String?            // MP payer user_id
  mpStatusDetail     String?            // MP status_detail del último pago (ej: cc_rejected_*)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan     @relation(fields: [planId], references: [id])

  @@index([businessId])
  @@index([mpSubscriptionId])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

// Deduplicación de webhooks — Rule 9: replay protection
// Almacena cada event_id recibido para evitar reprocesar el mismo evento
model WebhookEvent {
  id          String   @id @default(cuid())
  // Rule 9: event_id único para deduplicación — strategy: both
  eventId     String   @unique // x-request-id del webhook de MP
  eventType   String   // ej: "payment", "subscription_preapproval"
  processedAt DateTime @default(now())

  @@index([eventId])
  @@map("webhook_events")
}
