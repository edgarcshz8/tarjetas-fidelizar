generator client {
  provider = "prisma-client-js"
}

// DESARROLLO LOCAL: provider = "sqlite"
// PRODUCCIÓN (Dokploy): cambiar a provider = "postgresql"
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  logoUrl        String?
  primaryColor   String   @default("#1a1a2e")
  secondaryColor String   @default("#ffffff")
  accentColor    String   @default("#e94560")
  latitude         Float?
  longitude        Float?
  locationName     String?
  address          String?
  proximityEnabled Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt      DateTime @updatedAt

  programs     LoyaltyProgram[]
  users        User[]
  subscription Subscription?

  @@map("businesses")
}

model LoyaltyProgram {
  id                String   @id @default(cuid())
  businessId        String
  name              String
  description       String?
  stampsRequired    Int      @default(10)
  rewardDescription String
  stampIconUrl      String?
  rewardIconUrl     String?
  logoUrl           String?
  backgroundColor   String   @default("#1a1a2e")
  foregroundColor   String   @default("#ffffff")
  labelColor        String   @default("#cccccc")
  stampEmoji          String?  @default("⭐")
  isActive            Boolean  @default(true)
  // Google Wallet: ID de la clase (loyaltyClass) creada en Google
  googleClassId       String?
  // Mensaje personalizado de cumpleaños (soporta {nombre}, {negocio}, {premio})
  birthdayTitle       String?
  birthdayMessage     String?
  // Sistema de referidos (0 = desactivado)
  referralBonusReferrer Int    @default(0)   // sellos que gana quien refiere
  referralBonusReferred Int    @default(0)   // sellos que gana el referido
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  passes   CustomerPass[]

  @@map("loyalty_programs")
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  birthDate DateTime?
  createdAt DateTime  @default(now())

  passes CustomerPass[]

  @@unique([email])
  @@map("customers")
}

model CustomerPass {
  id                 String   @id @default(cuid())
  serialNumber       String   @unique @default(cuid())
  authToken          String   @default(cuid())
  customerId         String
  programId          String
  currentStamps      Int      @default(0)
  totalRewardsEarned Int      @default(0)
  rewardReady        Boolean  @default(false)
  // Apple Wallet: token del pase para APNS
  applePassUpdatedAt DateTime @default(now())
  // Último día (YYYY-MM-DD, hora Chile) en que se envió el aviso de cumpleaños.
  // Evita re-marcar el pase y re-enviar push si el cron corre varias veces el mismo día.
  birthdayNotifiedOn String?
  // Google Wallet: ID del objeto loyaltyObject
  googleObjectId     String?
  // Sistema de referidos: código corto único para compartir link de referido
  referralCode       String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customer         Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  program          LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  stamps           Stamp[]
  devices          AppleDevice[]
  referralsGiven   Referral[] @relation("ReferrerReferrals")
  referralReceived Referral?  @relation("ReferredReferrals")

  @@map("customer_passes")
}

// Registro de dispositivos Apple para push updates
model AppleDevice {
  id                     String   @id @default(cuid())
  deviceLibraryIdentifier String
  passSerialNumber       String
  pushToken              String
  createdAt              DateTime @default(now())

  pass CustomerPass @relation(fields: [passSerialNumber], references: [serialNumber], onDelete: Cascade)

  @@unique([deviceLibraryIdentifier, passSerialNumber])
  @@map("apple_devices")
}

model Stamp {
  id         String   @id @default(cuid())
  passId     String
  addedById  String
  note       String?
  createdAt  DateTime @default(now())

  pass    CustomerPass @relation(fields: [passId], references: [id], onDelete: Cascade)
  addedBy User         @relation(fields: [addedById], references: [id], onDelete: NoAction)

  @@map("stamps")
}

model User {
  id         String   @id @default(cuid())
  businessId String
  email      String   @unique
  password   String
  name       String
  role       String   @default("STAFF") // "OWNER" | "ADMIN" | "STAFF"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stamps   Stamp[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// REFERRALS
// ─────────────────────────────────────────────────────────────

model Referral {
  id             String   @id @default(cuid())
  referrerPassId String
  referredPassId String   @unique
  bonusGranted   Boolean  @default(false)
  createdAt      DateTime @default(now())

  referrerPass CustomerPass @relation("ReferrerReferrals", fields: [referrerPassId], references: [id], onDelete: Cascade)
  referredPass CustomerPass @relation("ReferredReferrals", fields: [referredPassId], references: [id], onDelete: Cascade)

  @@map("referrals")
}

// ─────────────────────────────────────────────────────────────
// BILLING — Mercado Pago Suscripciones (preapproval API)
// ─────────────────────────────────────────────────────────────

enum PlanInterval {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  PENDING    // valor existente en producción
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

/// Planes de suscripción disponibles. mpPlanId almacena el preapproval_plan id de MP.
model Plan {
  id           String       @id @default(cuid())
  name         String
  description  String?
  price        Int          @map("priceClp") // columna se llama priceClp en DB; zero-decimal CLP (Rule 6)
  intervalDays Int          @default(30)     // columna legada en DB
  interval     PlanInterval @default(MONTHLY)
  features     Json         @default("[]")
  mpPlanId     String?      // preapproval_plan id de Mercado Pago
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

/// Suscripción de un Business. Una sola suscripción activa por Business.
model Subscription {
  id                 String             @id @default(cuid())
  businessId         String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  mpSubscriptionId   String?            @unique // preapproval id de MP
  mpPreapprovalId    String?            // columna existente en DB (preapproval id legado)
  mpPayerId          String?
  mpStatusDetail     String?            // columna existente en DB
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan     @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

/// Registro de eventos de webhook procesados — deduplicación idempotente.
/// Rule 8: nunca almacenar el payload completo del evento.
model WebhookEvent {
  id          String   @id @default(cuid())
  mpEventId   String   @unique // id del evento en MP (dedup key)
  type        String
  processedAt DateTime @default(now())

  @@map("webhook_events")
}

