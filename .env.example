# ─────────────────────────────────────────────────────────────
# BASE
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/fidelizar"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-uno-con: openssl rand -base64 32"
APP_URL="http://localhost:3000"

# Secret para el cron job de cumpleaños — genera con: openssl rand -base64 32
# El cron debe llamar POST /api/notifications/birthday con header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="genera-uno-con: openssl rand -base64 32"

# ─────────────────────────────────────────────────────────────
# APPLE WALLET
# ─────────────────────────────────────────────────────────────
# Obtener en: https://developer.apple.com → Certificates, Identifiers & Profiles → Pass Type IDs
# 1. Crear un Pass Type ID (ej: pass.com.tuempresa.fidelizar)
# 2. Generar certificado → descargar y exportar como .p12
# 3. Convertir a PEM:
#    openssl pkcs12 -in Certificates.p12 -clcerts -nokeys -out certs/signerCert.pem
#    openssl pkcs12 -in Certificates.p12 -nocerts -nodes -out certs/signerKey.pem
#    Descargar WWDR de: https://www.apple.com/certificateauthority/ (G4 recomendado)

APPLE_PASS_TYPE_IDENTIFIER="pass.com.tuempresa.fidelizar"
APPLE_TEAM_IDENTIFIER="XXXXXXXXXX"
APPLE_KEY_PASSPHRASE=""

# ── Producción / Docker / Dokploy ────────────────────────────
# Encode cada PEM a base64 y pégalo como variable de entorno.
# En tu máquina (macOS/Linux):
#   base64 -i certs/signerCert.pem | tr -d '\n'   → pegar en APPLE_CERT_B64
#   base64 -i certs/signerKey.pem  | tr -d '\n'   → pegar en APPLE_KEY_B64
#   base64 -i certs/wwdr.pem       | tr -d '\n'   → pegar en APPLE_WWDR_B64
# En Windows (PowerShell):
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("certs\signerCert.pem"))
APPLE_CERT_B64=""
APPLE_KEY_B64=""
APPLE_WWDR_B64=""

# ── Desarrollo local (opcional, si prefieres archivos) ───────
# Si estas variables NO están seteadas, el código cae a los archivos:
APPLE_CERT_PATH="./certs/signerCert.pem"
APPLE_KEY_PATH="./certs/signerKey.pem"
APPLE_WWDR_PATH="./certs/wwdr.pem"

# Para push updates (APNS) - opcional pero recomendado
# Crear un push certificate para el Pass Type ID en Apple Developer
# Producción: base64 -i certs/apn_key.p8 | tr -d '\n' → APPLE_APN_KEY_B64
APPLE_APN_KEY_B64=""
APPLE_APN_KEY_PATH="./certs/apn_key.p8"
APPLE_APN_KEY_ID="XXXXXXXXXX"
# Usar APPLE_TEAM_IDENTIFIER para APN también

# Diagnóstico: GET /api/admin/check-apple  (requiere sesión admin)

# ─────────────────────────────────────────────────────────────
# GOOGLE WALLET
# ─────────────────────────────────────────────────────────────
# 1. Crear proyecto en Google Cloud Console
# 2. Habilitar "Google Wallet API"
# 3. Crear Service Account → descargar JSON de credenciales
# 4. En Google Pay & Wallet Console: https://pay.google.com/business/console
#    → Inscribirse como emisor → anotar el Issuer ID

GOOGLE_WALLET_ISSUER_ID="1234567890123456789"
# Pegar el contenido del JSON de la Service Account como string escapado:
GOOGLE_SERVICE_ACCOUNT_EMAIL="wallet@tu-proyecto.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# O usar la ruta al archivo JSON:
GOOGLE_SERVICE_ACCOUNT_KEY_FILE="./certs/google-service-account.json"
